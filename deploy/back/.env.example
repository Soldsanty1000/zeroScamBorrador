# Copia este archivo a .env (mismo folder) y ajusta.

# PC de la base de datos
DB_HOST=192.168.10.10
DB_PORT=3306
# La misma que MYSQL_APP_PASSWORD en deploy/db/.env
MYSQL_APP_PASSWORD=cambia_esto_tambien

# Secretos de la API (no arranca sin ellos). Genéralos en tu PC:
#   openssl rand -base64 48   -> JWT_SECRET
#   openssl rand -base64 32   -> EVIDENCE_KEY
JWT_SECRET=
EVIDENCE_KEY=

# Origen del panel que puede llamar a la API (CORS), tal como lo abre el navegador.
CORS_ORIGINS=http://192.168.20.10:3001

# URL de la API vista desde el navegador: la IP de ESTA PC.
# Si cambia, hay que reconstruir: docker compose up -d --build
NEXT_PUBLIC_API_URL=http://192.168.20.10:3000

# Laboratorio sin TLS: deja el panel hablar con la API por http:// dentro de la red.
# Con certificado (https://) ponlo en false.
ALLOW_INSECURE_API_URL=true

# Carpeta del repo del panel, relativa a esta (deploy/back).
# Si lo bajaste en ZIP se llama zeroscam-admin-main.
ADMIN_PATH=../../../zeroscam-admin

API_PORT=3000
ADMIN_PORT=3001

# Mailpit (códigos de dos pasos). 127.0.0.1 = solo desde esta PC;
# 0.0.0.0 = desde cualquier PC de la red.
MAILPIT_BIND=127.0.0.1
MAILPIT_PORT=8025

# Opcionales
SAFE_BROWSING_API_KEY=
MAIL_FROM=
