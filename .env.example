# Copia este archivo a .env y completa los valores. .env NO se sube a git.

# ---------- Obligatorias ----------
# Cadena de conexión de la API. Usa un usuario de MySQL SOLO con
# SELECT/INSERT/UPDATE/DELETE sobre la base (no root): `npm run setup:db` lo
# crea y deja esta línea lista.
# Formato: mysql://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL=mysql://zeroscam_app:TU_PASSWORD@localhost:3306/ZeroScam

# Llave con la que se firman los tokens (JWT). Mínimo 32 caracteres. Sin ella
# el servidor NO arranca. Genera una con:  openssl rand -base64 48
JWT_SECRET=

# Llave AES-256 con la que se cifran en disco las evidencias y avatares
# (32 bytes en base64). Sin ella el servidor NO arranca. Genera una con:
#   openssl rand -base64 32
# Si la pierdes, las evidencias ya guardadas no se pueden leer: respáldala.
EVIDENCE_KEY=

# ---------- Red ----------
# Por defecto la API solo escucha en esta máquina. Para que un iPhone o el
# panel de otra PC lleguen, usa HOST=0.0.0.0 (y de preferencia TLS, abajo).
HOST=127.0.0.1
PORT=3000
# Orígenes web autorizados por CORS (el panel), separados por coma.
CORS_ORIGINS=http://localhost:3001
# Opcional. TLS: rutas a la llave y al certificado (p. ej. generados con
# mkcert). Con ellos la API responde por HTTPS.
TLS_KEY_FILE=
TLS_CERT_FILE=

# ---------- Opcionales ----------
# Llave de Google Safe Browsing para la verificación de listas negras de
# POST /risk/analyze. Sin ella esa verificación se omite (y el análisis queda
# marcado como incompleto).
SAFE_BROWSING_API_KEY=

# Servidor de correo para el código de la verificación en dos pasos. Con
# Mailpit en esta misma máquina: smtp://localhost:1025
SMTP_URL=
MAIL_FROM=
# SOLO desarrollo y sin SMTP: escribe el código de dos pasos en la consola del
# servidor. Apagado por defecto (los códigos son credenciales).
DEV_LOG_2FA_CODES=false

# Swagger (/docs): abierto fuera de producción. En producción solo si defines
# usuario y contraseña, y entonces pide autenticación básica.
SWAGGER_USER=
SWAGGER_PASSWORD=

# ---------- Docker (docker compose up -d --build) ----------
# Con Docker, DATABASE_URL y SMTP_URL de arriba NO se usan: el compose arma
# las suyas apuntando a los contenedores de MySQL y Mailpit.

# Passwords de MySQL del contenedor. Solo letras y números (van dentro de una
# URL). Se fijan la PRIMERA vez que arranca la base. La API usa MYSQL_USER, que
# solo tiene SELECT/INSERT/UPDATE/DELETE; root queda solo para administración.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=zeroscam
MYSQL_PASSWORD=

# Carpeta del repo del panel (relativa a esta).
ADMIN_PATH=../admin-web

# URL de la API vista desde el NAVEGADOR de quien abre el panel.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Puertos en esta PC. API_BIND=127.0.0.1 publica la API solo en esta máquina;
# 0.0.0.0 la abre a la red local (usa TLS).
API_BIND=127.0.0.1
API_PORT=3000
ADMIN_PORT=3001
MAILPIT_PORT=8025
