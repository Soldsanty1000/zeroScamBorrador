# Copia este archivo a .env y pon los datos de TU MySQL.
# Formato: mysql://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL=mysql://root:TU_PASSWORD@localhost:3306/ZeroScam

# Obligatoria. Llave con la que se firman los tokens (mínimo 32 caracteres).
# Genera una propia: openssl rand -base64 48
# Si se filtra, cámbiala: todas las sesiones abiertas dejan de valer.
JWT_SECRET=

# Opcional. Llave de Google Safe Browsing para la verificación de listas
# negras de POST /risk/analyze. Sin ella esa verificación se omite.
# Se crea en https://console.cloud.google.com (API "Safe Browsing").
SAFE_BROWSING_API_KEY=

# Opcional. Servidor de correo para el código de la verificación en dos
# pasos. Con Mailpit en esta misma máquina: smtp://localhost:1025
# Sin ella el código se escribe en la consola del servidor.
SMTP_URL=
# Opcional. Remitente de esos correos.
MAIL_FROM=

# ---------- Docker (docker compose up -d --build) ----------
# Con Docker, DATABASE_URL y SMTP_URL de arriba NO se usan: el compose arma
# las suyas apuntando a los contenedores de MySQL y Mailpit.

# Password de root del MySQL del contenedor. Solo letras y números (va
# dentro de una URL). Se fija la PRIMERA vez que arranca la base.
MYSQL_ROOT_PASSWORD=cambia_esto

# Carpeta donde clonaste el repo del panel (zeroscam-admin), relativa a esta.
ADMIN_PATH=../zeroscam-admin

# URL de la API vista desde el NAVEGADOR de quien abre el panel. Con todo en
# la misma PC es http://localhost:3000; para usar el panel desde otra PC de
# la red, pon la IP de esta (http://192.168.1.50:3000) y reconstruye.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Puertos en esta PC
API_PORT=3000
ADMIN_PORT=3001
MYSQL_PORT=3307
MAILPIT_PORT=8025

# Origen(es) del panel que pueden leer la API desde el navegador (CORS), separados por coma.
# Sin esta variable: http://localhost:3001 y http://127.0.0.1:3001
#CORS_ORIGINS=http://localhost:3001
